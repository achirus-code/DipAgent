# Token the macOS app uses to authenticate with the agent (e.g. `openssl rand -base64 32`).
# Leave empty = the agent generates one and writes it to the log and to /data/api_token.
API_TOKEN=

# revolutx = real exchange, mock = simulated market to try things out
EXCHANGE=revolutx

# Revolut X is normally set up directly in the app (Settings → Revolut X).
# Alternatively set it here: API key (64 characters) + private key in ./secrets/revx_private.pem – takes precedence.
REVX_API_KEY=

# How often the bots check the market (seconds)
TICK_SECONDS=30

# Taker fee used to simulate paper trades (0.0009 = 0.09 %)
TAKER_FEE=0.0009

# Only for EXCHANGE=mock: time lapse (60 = one market hour per real minute)
MOCK_SPEED=1

# Only for the "AI decides" strategy: Claude decides when to buy and sell (key from console.anthropic.com)
ANTHROPIC_API_KEY=

# Time zone, used for "today" in the P&L summary
TZ=Europe/Berlin
